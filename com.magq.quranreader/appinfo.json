  "type": "web",
  "main": "index.html",
  "title": "Quran Reader",
  "icon": "images/icon.png",
  "miniicon": "images/miniicon.png",
  "uiRevision": 2,
  "keywords": ["quran", "koran", "surah", "juz"],
  "universalSearch": {
    "dbsearch": {
      "displayName": "Quran",
      "url": "com.magq.quranreader",
      "launchParam": "surah",
      "launchParamDbField": "id",
      "displayFields": ["display", "secondary", "blank", "id"],
      "dbQuery": {
        "from": "com.magq.quranreader.surah:1",
        "where": [{"prop": "search", "op": "?", "val": "", "collate": "primary"}],
        "limit": 20
      }
    }
  }
}
